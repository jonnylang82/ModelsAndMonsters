<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ModelsAndMonsters\ModelsAndMonsters.csproj" />
    <!-- The web observer's DTO projection (StateDto) is unit-tested here, so the live view's exit state and
         character dispositions are verified without a browser. -->
    <ProjectReference Include="..\..\src\ModelsAndMonsters.Web\ModelsAndMonsters.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests exercise the real prompt templates, so they are linked from the application project
         rather than duplicated here. -->
    <None Include="..\..\src\ModelsAndMonsters\Prompts\Templates\*.md"
          Link="Prompts\Templates\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The shipped scenarios are linked so tests can assert on the real seeded content, rather than a
         copy that could drift from what actually ships. -->
    <None Include="..\..\src\ModelsAndMonsters\scenario.json"
          Link="scenario.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ModelsAndMonsters\scenario_3_v_2.json"
          Link="scenario_3_v_2.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
