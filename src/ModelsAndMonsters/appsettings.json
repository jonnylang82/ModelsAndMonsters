{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning"
    }
  },
  "ModelsAndMonsters": {
    "Providers": {
      "Ollama": {
        "Endpoint": "http://localhost:11434"
      },
      "OpenAI": {
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY"
      },
      "Anthropic": {
        "ApiKeyEnvironmentVariable": "ANTHROPIC_API_KEY"
      }
    },
    "Agents": {
      "Default": {
        "Provider": "OpenAI",
        "ModelId": "gpt-5.4",
        "Temperature": 0.8,
        "TopP": 0.95,
        "TopK": 40,
        "MaxOutputTokens": 1500,
        "ContextWindow": 8192,
        "Effort": "none"
      },
      "DungeonMaster": {
        "Effort" : "none",
        "Temperature": 0.2,
        "TopP": 0.9,
        "MaxOutputTokens": 1700
      },
      "RulebookResolver": {
        "Effort": "none",
        "Temperature": 0.1,
        "TopP": 0.9,
        "MaxOutputTokens": 600
      },
      "Characters": {
        "hero-rowan": {},
        "hero-elara": {},
        "goblin-vark": {},
        "goblin-skrit": {}
      }
    },
    "Harness": {
      "Seed": null,
      "MaxRounds": 12,
      "MaxModelCallsPerTurn": 10,
      "MaxQuestionsPerTurn": 2,
      "MaxActionAttemptsPerTurn": 3,
      "MaxAdjudicationRetries": 1,
      "ProjectDungeonMasterContext": true,
      "MaxConsecutiveIdleRounds": 3,
      "RecoverTextToolCalls": true,
      "EnableRulebookResolver": true,
      "RulebookMaxCards": 32,
      "RulebookMaxInputChars": 32000,
      "RulebookOutputTokens": 600,
      "RulebookCacheEnabled": true,
      "RunOutputDirectory": "runs"
    },
    "Combat": {
      "GlancingBlowChance": 25,
      "BaseStealChance": 40
    }
  }
}
